---
// Materials: Lohen's verified 6.6 totals plus farming locations, resin cost, and time
// estimates. Real item icons are used where official art exists; fictional 6.6 items
// (Frostcore Crystal, Cryoregal Core, Crown, Mora) use a frost SVG glyph tile.
const glyphs = {
  crystal: `<path d="M12 3l6 5-2 10H8L6 8z" /><path d="M8 8l4-1 4 1" />`,
  core: `<path d="M12 3l7 4v7l-7 4-7-4V7z" /><circle cx="12" cy="11" r="3" />`,
  crown: `<path d="M4 9l4 3 4-5 4 5 4-3v8H4z" /><path d="M7 17h10" />`,
  coin: `<circle cx="12" cy="12" r="8" /><path d="M12 8v8M9.5 10.5h5M9.5 13.5h5" />`,
};

const ascension = [
  { k: "Cryo gems", v: "Shivada Jade Sliver x1, Fragment x9, Chunk x9, Gemstone x6", src: "Cryo field bosses (Cryo Hypostasis, Cryo Regisvine), or convert with Dust of Azoth", icon: "/materials/shivada-gemstone.webp" },
  { k: "Local specialty", v: "Frostcore Crystal x168", src: "Cold surfaces near ice flows and mountain ridges in the 6.6 region; respawns every 48 hours", icon: "/materials/frostcore-crystal.webp" },
  { k: "Common drops", v: "Knight's Insignia (Recruit's x18, Sergeant's x30, Lieutenant's x36)", src: "Fatui Skirmishers across Teyvat, or crafted from lower tiers", icon: "/materials/insignia-recruit.webp" },
  { k: "Boss drop", v: "Cryoregal Core x46", src: "The new 6.6 weekly boss; cannot be obtained before release", icon: "/materials/cryoregal-core.webp" },
  { k: "Mora", v: "2,400,000", src: "Ley Lines, quests, events", icon: "/materials/mora.webp" },
];

const talent = [
  { k: "Talent books", v: "Teachings of Ballad x9, Guide x63, Philosophies x114", src: "Forsaken Rift domain, Mondstadt (Wed/Sat/Sun)", icon: "/materials/ballad-philosophies.webp" },
  { k: "Common drops", v: "Knight's Insignia (Recruit's x18, Sergeant's x66, Lieutenant's x93)", src: "Fatui Skirmishers, or exchange Stardust in the shop", icon: "/materials/insignia-recruit.webp" },
  { k: "Weekly boss", v: "Mirror of Mushin x18", src: "The new 6.6 weekly boss (one drop per kill, ~6 weeks)", icon: "/materials/mirror-mushin.webp" },
  { k: "Crowns", v: "Crown of Insight x3", src: "Limited events and offerings", icon: "/materials/crown-insight.webp" },
  { k: "Mora", v: "4,950,000 (all three talents)", src: "Ley Lines, quests, events", icon: "/materials/mora.webp" },
];

const rankCost = [
  { lv: "20→40", gems: "Shivada Jade Sliver x1", local: "Frostcore Crystal x3", drops: "Recruit's Insignia x3", boss: "—" },
  { lv: "40→50", gems: "Shivada Jade Fragment x3", local: "Frostcore Crystal x10", drops: "Recruit's Insignia x15", boss: "Cryoregal Core x2" },
  { lv: "50→60", gems: "Shivada Jade Fragment x6", local: "Frostcore Crystal x20", drops: "Sergeant's Insignia x12", boss: "Cryoregal Core x4" },
  { lv: "60→70", gems: "Shivada Jade Chunk x3", local: "Frostcore Crystal x30", drops: "Sergeant's Insignia x18", boss: "Cryoregal Core x8" },
  { lv: "70→80", gems: "Shivada Jade Chunk x6", local: "Frostcore Crystal x45", drops: "Lieutenant's Insignia x12", boss: "Cryoregal Core x12" },
  { lv: "80→90", gems: "Shivada Jade Gemstone x6", local: "Frostcore Crystal x60", drops: "Lieutenant's Insignia x24", boss: "Cryoregal Core x20" },
];

const farming = [
  {
    name: "Frostcore Crystal",
    cost: "168 needed, 48-hour respawn",
    icon: "/materials/frostcore-crystal.webp",
    detail: "The longest grind. Spawns on cold surfaces near ice flows and mountain ridges in the 6.6 region. The 48-hour respawn forces multiple real-time days, so start early or use a friend's world to double your daily yield.",
  },
  {
    name: "Cryoregal Core",
    cost: "46 needed, ~4-6 weeks",
    icon: "/materials/cryoregal-core.webp",
    detail: "Dropped by the new 6.6 weekly boss. You only get 1-2 per week, so it takes roughly 4-6 weeks to collect all 46. Start the week Lohen releases and never skip a weekly kill.",
  },
  {
    name: "Ballad books",
    cost: "186 books, Wed/Sat/Sun only",
    icon: "/materials/ballad-teachings.webp",
    detail: "Farmed in the Forsaken Rift domain in Mondstadt on Wednesday, Saturday, and Sunday. Use Condensed Resin to halve the Resin cost and double the yield per run.",
  },
  {
    name: "Mirror of Mushin",
    cost: "18 needed, ~6 weeks",
    icon: "/materials/mirror-mushin.webp",
    detail: "A weekly boss drop for talent upgrades. You need six per talent across three talents. Use Dream Solvent to convert other weekly boss drops if you get the wrong material.",
  },
];

const pitfalls = [
  {
    t: "Frostcore Crystal is the longest grind",
    b: "You need 168 of them with a 48-hour respawn, so they cannot be rushed with Resin. Start gathering the moment Lohen is announced.",
  },
  {
    t: "The weekly boss is the true gate",
    b: "Cryoregal Core and Mirror of Mushin only drop from the 6.6 weekly boss, one or two per week. Missing a week sets you back a full week.",
  },
  {
    t: "Crown the Skill and Normal Attack",
    b: "Crown the Elemental Skill first, then Normal Attack. Only crown the Burst if you have surplus Crowns — it is a single hit per rotation.",
  },
  {
    t: "Farm Ballad books on their days",
    b: "The talent book domain only opens Wednesday, Saturday, and Sunday. Spend your daily Resin there once the local specialty and insignias are done.",
  },
  {
    t: "Convert drops upward, do not re-farm",
    b: "Use the alchemy table to convert lower-tier insignias and gems upward, and Dream Solvent to fix wrong weekly boss drops.",
  },
];
---

<section id="materials" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Lohen Ascension &amp; Talent Materials
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-400">
      Everything except the weekly boss drops can be pre-farmed before the banner goes live. The
      only true bottleneck is the weekly boss — one or two drops per week, roughly six weeks to
      finish — so plan around that gate.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
        <h3 class="text-base font-semibold text-stone-100">Ascension (to level 90)</h3>
        <dl class="mt-4 space-y-4">
          {ascension.map((a) => (
            <div class="flex gap-4 border-b border-stone-800/60 pb-4 last:border-0 last:pb-0">
              {a.icon ? (
                <img
                  src={a.icon}
                  alt={`${a.k} icon`}
                  width="256"
                  height="256"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 shrink-0 self-start rounded-xl border border-stone-700/50 bg-white/60"
                />
              ) : (
                <span
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-frost-600/30 bg-frost-950/60 text-frost-600"
                  aria-hidden="true"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[a.glyph]} />
                </span>
              )}
              <div class="min-w-0 flex-1">
                <dt class="text-sm font-medium text-stone-200">{a.k}</dt>
                <dd class="mt-1 text-sm text-stone-300">{a.v}</dd>
                <dd class="mt-1 text-xs text-stone-500">{a.src}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>

      <div class="rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
        <h3 class="text-base font-semibold text-stone-100">Talent (all three to level 10)</h3>
        <dl class="mt-4 space-y-4">
          {talent.map((a) => (
            <div class="flex gap-4 border-b border-stone-800/60 pb-4 last:border-0 last:pb-0">
              {a.icon ? (
                <img
                  src={a.icon}
                  alt={`${a.k} icon`}
                  width="256"
                  height="256"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 shrink-0 self-start rounded-xl border border-stone-700/50 bg-white/60"
                />
              ) : (
                <span
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-frost-600/30 bg-frost-950/60 text-frost-600"
                  aria-hidden="true"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[a.glyph]} />
                </span>
              )}
              <div class="min-w-0 flex-1">
                <dt class="text-sm font-medium text-stone-200">{a.k}</dt>
                <dd class="mt-1 text-sm text-stone-300">{a.v}</dd>
                <dd class="mt-1 text-xs text-stone-500">{a.src}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <h3 class="mt-14 text-xl font-bold tracking-tight text-stone-50">Ascension by Level</h3>
    <div class="mt-5 overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-sm">
        <thead>
          <tr class="text-left">
            <th class="py-3 pr-4 font-medium text-stone-500">Level</th>
            <th class="px-4 py-3 font-medium text-stone-500">Gems</th>
            <th class="px-4 py-3 font-medium text-stone-500">Local specialty</th>
            <th class="px-4 py-3 font-medium text-stone-500">Enemy drops</th>
            <th class="px-4 py-3 font-medium text-stone-500">Boss</th>
          </tr>
        </thead>
        <tbody>
          {rankCost.map((r, i) => (
            <tr class={i === rankCost.length - 1 ? "" : "border-b border-stone-800/70"}>
              <td class="py-3 pr-4 font-mono text-xs text-stone-300">{r.lv}</td>
              <td class="px-4 py-3 text-stone-300">{r.gems}</td>
              <td class="px-4 py-3 text-stone-300">{r.local}</td>
              <td class="px-4 py-3 text-stone-300">{r.drops}</td>
              <td class="px-4 py-3 text-stone-300">{r.boss}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-stone-500">
      Totals match the checklist: 168 Frostcore Crystal, 46 Cryoregal Core, and 84 Knight's
      Insignia across all six ranks.
    </p>

    <h3 class="mt-14 text-xl font-bold tracking-tight text-stone-50">Farming Routes &amp; Costs</h3>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {farming.map((f) => (
        <div class="flex gap-4 rounded-xl border border-stone-800 bg-stone-900/30 p-5">
          {f.icon ? (
            <img
              src={f.icon}
              alt={`${f.name} icon`}
              width="256"
              height="256"
              loading="lazy"
              decoding="async"
              class="h-14 w-14 shrink-0 self-start rounded-xl border border-stone-700/50 bg-white/60"
            />
          ) : (
            <span
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-frost-600/30 bg-frost-950/60 text-frost-600"
              aria-hidden="true"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[f.glyph]} />
            </span>
          )}
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <p class="font-semibold text-stone-100">{f.name}</p>
              <span class="shrink-0 font-mono text-xs text-frost-600">{f.cost}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-stone-400">{f.detail}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14">
      <h3 class="text-xl font-bold tracking-tight text-stone-50">Common Mistakes to Avoid</h3>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {pitfalls.map((p) => (
          <div class="rounded-xl border border-stone-800 bg-stone-900/30 p-5">
            <p class="font-semibold text-stone-100">{p.t}</p>
            <p class="mt-2 text-sm leading-relaxed text-stone-400">{p.b}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
