---
// TOC: top-of-page table of contents with anchor links to every section.
// Serves as both UX navigation and internal linking for SEO.
const links = [
  { href: "#top", label: "Character Overview", short: "Overview" },
  { href: "#mechanics", label: "Mechanics Explained", short: "Mechanics" },
  { href: "#pull", label: "Pull Decision Tool", short: "Should You Pull?" },
  { href: "#combo", label: "Hexerei Combo Player", short: "Combo" },
  { href: "#skills", label: "Skills & Talents", short: "Skills" },
  { href: "#build", label: "Best Build", short: "Build" },
  { href: "#teams", label: "Best Teams", short: "Teams" },
  { href: "#materials", label: "Materials & Farming", short: "Materials" },
  { href: "#calc", label: "Material Calculator", short: "Calculator" },
  { href: "#cost", label: "Pull Cost Calculator", short: "Cost" },
  { href: "#pitfalls", label: "Common Mistakes", short: "Mistakes" },
  { href: "#faq", label: "FAQ", short: "FAQ" },
];
---

<section class="border-b border-slate-800/70 bg-slate-900/30">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-slate-500">
      Table of Contents
    </h2>
    <nav aria-label="Table of contents" class="mt-4">
      <ol class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="group flex items-center gap-2 rounded-lg border border-slate-800 px-3 py-2 text-xs font-medium text-slate-300 transition-colors hover:border-frost-500 hover:text-frost-400"
            >
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-frost-500" aria-hidden="true"></span>
              {l.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>
