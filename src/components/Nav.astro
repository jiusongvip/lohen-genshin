---
const links = [
  { href: "#build", label: "Build" },
  { href: "#compare", label: "Compare" },
  { href: "#howto", label: "How to Play" },
  { href: "#lore", label: "Lore" },
  { href: "#materials", label: "Materials" },
  { href: "#faq", label: "FAQ" },
];
---

<nav
  id="main-nav"
  class="fixed left-0 right-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
  aria-label="Primary navigation"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="nav-logo flex items-center gap-2 text-stone-100 transition-colors" aria-label="Lohen Genshin Guide home">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2C8 6 5 9 5 14a7 7 0 0 0 14 0c0-5-3-8-7-12z" fill="currentColor" class="text-frost-500" />
        <path d="M12 13a2.5 2.5 0 0 0 2.5 2.5A2.5 2.5 0 0 0 12 18a2.5 2.5 0 0 0-2.5-2.5A2.5 2.5 0 0 0 12 13z" fill="#100e0b" />
      </svg>
      <span class="font-display text-lg font-bold tracking-tight">Lohen Guide</span>
    </a>

    <div class="hidden items-center gap-6 text-sm lg:flex">
      {links.map((l) => (
        <a href={l.href} class="nav-link">{l.label}</a>
      ))}
    </div>

    <button
      id="mobile-menu-btn"
      class="nav-mobile-btn inline-flex h-12 w-12 items-center justify-center text-stone-100 lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-stone-800 bg-stone-950/95 px-6 py-4 backdrop-blur-lg lg:hidden">
    <div class="flex flex-col gap-1">
      {links.map((l) => (
        <a href={l.href} class="block rounded-lg px-2 py-3 text-base text-stone-300 transition-colors hover:bg-stone-800/60 hover:text-frost-600">{l.label}</a>
      ))}
    </div>
  </div>
</nav>
