---
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Frequently Asked Questions
    </h2>
    <p class="mt-4 text-base leading-relaxed text-stone-400">
      Quick answers to the most common Lohen questions.
    </p>

    <div class="mt-8 space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-2xl border border-stone-800 bg-stone-900/30 open:bg-stone-900/50">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base font-medium text-stone-100 [&::-webkit-details-marker]:hidden">
            {f.q}
            <span
              class="shrink-0 text-stone-500 transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="px-5 pb-5 text-sm leading-relaxed text-stone-400">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
