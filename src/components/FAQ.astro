---
// FAQ. Each answer leads with a conclusion + number to target featured snippets.
interface Faq {
  q: string;
  a: string;
}
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<section id="faq" class="border-b border-slate-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
      Lohen FAQ
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-400">
      Quick answers to the most common questions about Lohen, his mechanics, and his
      build.
    </p>

    <div class="mt-10 space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-2xl border border-slate-800 bg-slate-900/40 p-5">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-slate-100">
            {f.q}
            <span class="ml-4 text-slate-500 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
