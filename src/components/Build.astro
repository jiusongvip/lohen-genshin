---
// Build: weapons, artifacts, constellations with selection reasoning and
// numerical analysis. Goes beyond recommendation lists to explain the why.
const weapons = [
  {
    name: "Disaster and Remorse",
    tier: "Signature",
    note: "Best-in-slot. Boosts CRIT and Hexerei chain damage.",
    reason: "Disaster and Remorse is Lohen's signature polearm and his best-in-slot weapon. It provides 608 base ATK and 66.2 percent CRIT DMG at level 90, which directly amplifies his Hexerei chain damage. Its passive increases CRIT Rate and grants a Hexerei-specific damage bonus when the wielder is in an enhanced state, which perfectly overlaps with Masterstroke. Because Lohen's damage is concentrated in the Hexerei chains and the enhanced skill, the weapon's passive is active during his entire damage window, making it the strongest option by a clear margin.",
  },
  {
    name: "Primordial Jade Winged-Spear",
    tier: "5-Star",
    note: "Strong alternative, stacks ATK on hits.",
    reason: "Primordial Jade Winged-Spear is the strongest non-signature alternative. It provides 608 base ATK and 33.1 percent CRIT Rate, and its passive stacks ATK on each hit, up to 7 stacks for a 28 percent ATK bonus and a 12 percent damage bonus on the final hit. Because the Hexerei chain lands four rapid hits, the weapon reaches its full stack bonus quickly and the damage amp lands on the highest-multiplier hit. It is roughly 8 to 10 percent behind the signature weapon but is a standard banner 5-star that many players already own.",
  },
  {
    name: "White Tassel",
    tier: "3-Star",
    note: "Free F2P pick, boosts Normal Attack DMG.",
    reason: "White Tassel is the best free-to-play option. It is a 3-star polearm obtainable from Liyue chests, providing 401 base ATK and 23.4 percent CRIT Rate. Its passive increases Normal Attack damage by a flat percentage, which directly amplifies the Hexerei chains since they are classified as Normal Attacks under Masterstroke. It is roughly 20 percent behind the signature weapon but requires zero pulls, making it the clear F2P choice for players who do not have a 5-star polearm.",
  },
  {
    name: "Staff of Homa",
    tier: "5-Star",
    note: "Close alternative in Freeze; strong HP-synergy passive.",
    reason: "Staff of Homa is a strong niche pick. It provides 608 base ATK and 66.2 percent CRIT DMG at level 90, matching Disaster and Remorse on substat value. Its passive grants a flat ATK% bonus scaled by max HP, which is less useful for Lohen because his kit does not scale with HP. However, the CRIT DMG alone makes it competitive: it is roughly 6 to 8 percent behind the signature weapon in a Melt comp, and within 3 percent in a Freeze comp where the passive's uptime is easier to maintain. A solid choice if you already own it.",
  },
  {
    name: "Calamity Queller",
    tier: "5-Star",
    note: "High base ATK, ATK% passive that stacks on Elemental Skill.",
    reason: "Calamity Queller provides 741 base ATK (the highest of any polearm) and 16.5 percent ATK. Its passive grants a stacking ATK% bonus whenever the wielder casts an Elemental Skill, which Lohen does to enter Masterstroke and again for the enhanced skill. Because Lohen casts his Skill twice per rotation, the passive reaches most of its stacks during his damage window. It is roughly 9 to 11 percent behind the signature weapon, and pulls ahead of Jade Winged-Spear in teams with heavy ATK buffs where the flat ATK stacks are diluted less.",
  },
  {
    name: "Missive Windspear",
    tier: "4-Star",
    note: "Free event polearm, strong budget pick.",
    reason: "Missive Windspear is the best 4-star event option for players who missed White Tassel or want a higher base ATK. It provides 510 base ATK and 27.6 percent ATK as a substat, and its passive grants an ATK% and Elemental Mastery buff when a reaction is triggered. Since Lohen triggers Melt constantly, the passive has near-permanent uptime. It is roughly 25 percent behind the signature weapon but fully free from a past event, making it the second-best F2P option after White Tassel for players who have both leveled.",
  },
  {
    name: "Deathmatch",
    tier: "4-Star",
    note: "CRIT Rate substat, strong for stat balance.",
    reason: "Deathmatch is the best 4-star stat stick. It provides 454 base ATK and 36.8 percent CRIT Rate at level 90, which dramatically eases Lohen's artifact requirements — with the 8 percent Cold Front passive and 24 percent ascension bonus, you can reach a healthy CRIT Rate while stacking CRIT DMG on every piece. Its passive grants an ATK% bonus when two or more enemies are nearby, and a defense bonus against one enemy. It is roughly 22 to 24 percent behind the signature weapon in single-target but closes much of the gap in multi-target content. Only available via the Battle Pass.",
  },
];

const artifacts = [
  {
    set: "A Day Carved From Rising Winds (4pc)",
    note: "Best-in-slot. ATK and CRIT bonuses that scale Hexerei chains.",
    reason: "A Day Carved From Rising Winds is Lohen's best-in-slot artifact set. The 2-piece bonus grants 18 percent ATK, and the 4-piece bonus grants a stacking CRIT Rate and CRIT DMG bonus when the wearer uses their Elemental Skill, which Lohen does to enter Masterstroke. Because the 4-piece bonus is active for the entire Masterstroke window, it amplifies every Hexerei chain and the enhanced skill. The set is farmable in the new 6.6 domain and is the long-term target for any serious Lohen build.",
  },
  {
    set: "Blizzard Strayer (4pc)",
    note: "Strong in Freeze teams, conditional CRIT Rate.",
    reason: "Blizzard Strayer is a strong alternative in Freeze teams. The 4-piece bonus grants up to 40 percent CRIT Rate against Frozen enemies, which dramatically reduces the CRIT Rate you need from artifacts. However, it only works in Freeze comps where enemies are actually Frozen, making it a situational pick rather than a universal one. Use it if your team applies Hydro consistently and you fight enemies that can be Frozen.",
  },
  {
    set: "2pc ATK + 2pc ATK",
    note: "Budget option while farming the BiS set.",
    reason: "A 2-piece ATK plus 2-piece ATK combination (such as Gladiator's Finale plus Shimenawa's Reminiscence) is the budget option while you farm the best-in-slot set. It provides a flat 36 percent ATK bonus with no conditional requirements, making it reliable across all team archetypes. It is roughly 15 percent behind the 4-piece best-in-slot set but is available immediately from existing artifact strongboxes.",
  },
  {
    set: "Echoes of an Offering (4pc)",
    note: "Situational; can double the first Hexerei hit.",
    reason: "Echoes of an Offering has a conditional 36 percent chance to trigger a damage instance equal to 70 percent of ATK when a Normal Attack hits, provided the character has 15 Energy or more. Because Hexerei chains are Normal Attacks, each hit can proc this echo. It is highly RNG-dependent: on average it lands close to the 2pc ATK + 2pc ATK build, but high-roll procs on the back half of the chain outperform. Only consider it if you already have a fully optimized set; otherwise the variance is not worth the farm.",
  },
  {
    set: "Emblem of Severed Fate (4pc)",
    note: "Burst-focused niche; ER scales Burst damage.",
    reason: "Emblem of Severed Fate converts 25 percent of Energy Recharge into Burst damage bonus, up to 75 percent. Because Lohen needs 120 to 130 percent ER anyway, the 4-piece bonus effectively adds a small Burst damage buff for free. However, Lohen's damage is dominated by the Hexerei chains and the enhanced Skill, not the Burst, so Emblem only competes when your Lohen is heavily invested in Burst damage and ER. It is a viable niche build but roughly 20 percent behind the best-in-slot in full-rotation damage.",
  },
];

const mainstats = [
  { slot: "Sands", main: "ATK%", reason: "ATK% scales all of Lohen's damage, which is all ATK-based. Energy Recharge sands are an option if you struggle to burst each rotation, but ATK% is the default." },
  { slot: "Goblet", main: "Cryo DMG Bonus", reason: "Cryo DMG Bonus is the correct goblet because all of Lohen's damage is Cryo. It provides a larger damage increase than ATK% on the goblet slot due to how damage formulas weight elemental damage." },
  { slot: "Circlet", main: "CRIT Rate / CRIT DMG", reason: "Choose CRIT Rate or CRIT DMG based on your current ratio. Aim for a 1:2 CRIT Rate to CRIT DMG ratio. With the Cold Front passive granting 8 percent CRIT Rate during Masterstroke, you can lean slightly toward CRIT DMG." },
];

const substats = ["CRIT Rate", "CRIT DMG", "ATK%", "Energy Recharge", "ATK"];

const constellationPriority = [
  { c: "C0", note: "Fully functional. The baseline experience." },
  { c: "C1", note: "Best value. Extra Joy generation extends Masterstroke uptime." },
  { c: "C2", note: "Team-wide Cryo DMG bonus. Strong in Melt comps." },
  { c: "C6", note: "Capstone. Hexerei chains gain massive multipliers." },
];

const constellationDetails = [
  { c: "C1", name: "Opening Gambit", effect: "Casting the Elemental Skill grants 4 extra Joy. Extends Masterstroke uptime by roughly 20%.", pct: "+10-12% total DPS" },
  { c: "C2", name: "Field Commander", effect: "While in Masterstroke, party members gain a 15% Cryo DMG Bonus.", pct: "+8-10% team DPS" },
  { c: "C3", name: "Tactical Mind", effect: "Increases Elemental Skill level by 3. Enhanced skill gains +~39% base multiplier.", pct: "+5-6% personal DPS" },
  { c: "C4", name: "Vanguard's Fury", effect: "Hexerei chain hits restore 1 Energy each. Improves Burst uptime.", pct: "utility (energy)" },
  { c: "C5", name: "Decisive Strike", effect: "Increases Normal Attack level by 3. Hexerei chain gains +~12% per hit.", pct: "+3-4% personal DPS" },
  { c: "C6", name: "Masterstroke Apex", effect: "Hexerei chain damage gains a 40% multiplier and the final hit triggers an additional Cryo blast.", pct: "+25-30% during Masterstroke" },
];

const skillLevelsExtended = [
  { talent: "Normal Attack", lv11: "186 / 200 / 214 / 228%", lv12: "200 / 215 / 230 / 245%", lv13: "214 / 230 / 246 / 262%" },
  { talent: "Elemental Skill", lv11: "333%", lv12: "358%", lv13: "383%" },
  { talent: "Elemental Burst", lv11: "1,034%", lv12: "1,112%", lv13: "1,190%" },
];

const weaponCompare = [
  { metric: "Base ATK (Lv. 90)", dr: "608", jade: "608", tassel: "401", homa: "608", queller: "741", deathmatch: "454" },
  { metric: "Substat", dr: "CRIT DMG 66.2%", jade: "CRIT Rate 33.1%", tassel: "CRIT Rate 23.4%", homa: "CRIT DMG 66.2%", queller: "ATK 16.5%", deathmatch: "CRIT Rate 36.8%" },
  { metric: "Passive synergy", dr: "Hexerei chain DMG", jade: "Stacking ATK on hit", tassel: "Normal Attack DMG", homa: "HP-scaled ATK%", queller: "Skill-triggered ATK%", deathmatch: "ATK% vs 2+ enemies" },
  { metric: "vs BiS (approx)", dr: "—", jade: "-8 to -10%", tassel: "-20%", homa: "-6 to -8%", queller: "-9 to -11%", deathmatch: "-22 to -24%" },
  { metric: "F2P", dr: "No", jade: "No", tassel: "Yes (free)", homa: "No", queller: "No", deathmatch: "No (BP)" },
  { metric: "Verdict", dr: "Best-in-slot", jade: "Strong 5-star alt", tassel: "Best F2P pick", homa: "Freeze niche", queller: "High-ATK alt", deathmatch: "Best 4-star stat stick" },
];

const teamBuilds = [
  {
    archetype: "Melt Comp (recommended)",
    weapon: "Disaster and Remorse",
    set: "A Day Carved From Rising Winds (4pc)",
    sands: "ATK%",
    goblet: "Cryo DMG",
    circlet: "CRIT DMG (with 1:2 ratio)",
    note: "Prioritize CRIT DMG on the circlet because Cold Front, the ascension bonus, and most weapons already provide CRIT Rate. Aim for 50% CRIT Rate effective (42% on artifacts + 8% passive) and as much CRIT DMG as possible.",
  },
  {
    archetype: "Freeze Comp",
    weapon: "Disaster and Remorse / Staff of Homa",
    set: "Blizzard Strayer (4pc)",
    sands: "ATK%",
    goblet: "Cryo DMG",
    circlet: "CRIT DMG (heavy)",
    note: "Blizzard Strayer provides up to 40% CRIT Rate against Frozen enemies, so stack CRIT DMG aggressively. With 40% from the set, 24% ascension, and 8% passive, you need almost no CRIT Rate on artifacts — go all-in on CRIT DMG and ATK.",
  },
  {
    archetype: "F2P / Starter",
    weapon: "White Tassel",
    set: "2pc ATK + 2pc ATK",
    sands: "ATK%",
    goblet: "Cryo DMG",
    circlet: "CRIT Rate",
    note: "White Tassel gives 23.4% CRIT Rate plus 24% ascension plus 8% passive, so a CRIT Rate circlet pushes you past 60% effective. Balance toward CRIT DMG on substats. This build is roughly 20% behind the full investment but fully clears endgame.",
  },
];

const statTargets = [
  { stat: "CRIT Rate", target: "50%+ (42% + 8% passive)", note: "Aim for 50 percent with the Cold Front passive active, so 42 percent on the artifacts page." },
  { stat: "CRIT DMG", target: "100%+ minimum", note: "Push as high as possible after CRIT Rate hits the target. 150 percent is a strong endgame goal." },
  { stat: "ATK", target: "1,800+ total", note: "Total ATK including weapon and artifacts. Higher is better, but do not sacrifice CRIT for ATK." },
  { stat: "Energy Recharge", target: "120-130%", note: "Enough to guarantee Burst each rotation. Drop to 110 percent if running a Cryo battery teammate." },
];
---

<section id="build" class="border-b border-slate-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
      Best Lohen Build
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-400">
      The complete build for Lohen: weapons, artifacts, main stats, substats, and
      constellations, each with the reasoning behind the recommendation. Farm a CRIT
      circlet and Cryo goblet first, ATK sands second. His signature polearm is optimal
      but not required.
    </p>

    <div class="mt-8 rounded-2xl border border-frost-700/40 bg-frost-950/20 p-6 sm:p-8">
      <h3 class="text-lg font-bold text-frost-400">Build Philosophy</h3>
      <p class="mt-3 text-base leading-relaxed text-slate-300">
        Lohen's damage is concentrated in two places: the Hexerei chains, which fire four
        rapid Cryo hits under Masterstroke, and the enhanced Elemental Skill, which is
        his highest single-hit multiplier. A good build amplifies both, which means
        prioritizing CRIT stats (because the chains hit many times and each can crit),
        ATK (because all his damage is ATK-scaling), and enough Energy Recharge to
        guarantee the Burst each rotation. Cryo DMG on the goblet is non-negotiable
        because every damage instance he deals is Cryo.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <h3 class="text-lg font-bold text-slate-100">Weapons</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Lohen's weapon should amplify CRIT and Normal Attack damage, since his Hexerei
          chains are classified as Normal Attacks. The three picks below cover signature,
          alternative, and free-to-play options.
        </p>
        <div class="mt-4 divide-y divide-slate-800">
          {weapons.map((w) => (
            <div class="py-3">
              <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-slate-100">{w.name}</p>
                <span class="rounded-full border border-frost-700/50 px-2 py-0.5 text-xs font-medium text-frost-400">
                  {w.tier}
                </span>
              </div>
              <p class="mt-1 text-xs leading-relaxed text-slate-400">{w.note}</p>
              <p class="mt-2 border-t border-slate-800/60 pt-2 text-xs leading-relaxed text-slate-500">
                {w.reason}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <h3 class="text-lg font-bold text-slate-100">Artifacts</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          The artifact set should amplify CRIT and ATK during the Masterstroke window.
          The three options below cover best-in-slot, situational, and budget picks.
        </p>
        <div class="mt-4 divide-y divide-slate-800">
          {artifacts.map((a) => (
            <div class="py-3">
              <p class="text-sm font-semibold text-slate-100">{a.set}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-400">{a.note}</p>
              <p class="mt-2 border-t border-slate-800/60 pt-2 text-xs leading-relaxed text-slate-500">
                {a.reason}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <h3 class="text-lg font-bold text-slate-100">Main Stats</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          The main stat on each artifact slot, with the reasoning for each choice.
        </p>
        <div class="mt-4 space-y-4">
          {mainstats.map((m) => (
            <div class="rounded-xl border border-slate-800 p-4">
              <div class="flex items-center justify-between">
                <p class="text-xs font-medium uppercase tracking-[0.1em] text-slate-500">{m.slot}</p>
                <p class="text-sm font-semibold text-frost-400">{m.main}</p>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-slate-500">{m.reason}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <h3 class="text-lg font-bold text-slate-100">Substats Priority</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Roll priority for artifact substats. CRIT stats come first because the Hexerei
          chain hits many times and each hit can crit independently.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {substats.map((s, i) => (
            <span class="rounded-full border border-slate-700 px-3 py-1 text-xs font-medium text-slate-300">
              {i + 1}. {s}
            </span>
          ))}
        </div>
        <div class="mt-6 border-t border-slate-800/60 pt-4">
          <p class="text-sm font-semibold text-slate-100">Stat Targets (Lv. 90)</p>
          <div class="mt-3 space-y-3">
            {statTargets.map((t) => (
              <div class="rounded-xl border border-slate-800 p-3">
                <div class="flex items-center justify-between">
                  <p class="text-xs font-medium text-slate-400">{t.stat}</p>
                  <p class="text-sm font-bold text-frost-400">{t.target}</p>
                </div>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-500">{t.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h3 class="text-lg font-bold text-slate-100">Constellation Priority</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        Lohen works at C0, but constellations add meaningful value. The priority below
        ranks which constellations are worth chasing, based on damage increase per pull
        cost.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {constellationPriority.map((c) => (
          <div class="rounded-xl border border-slate-800 p-4">
            <p class="text-sm font-bold text-frost-400">{c.c}</p>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">{c.note}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h3 class="text-lg font-bold text-slate-100">Constellation Effects (Layer by Layer)</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        What each constellation actually does, so you can decide how far to invest. C1 is
        the best value because it extends Masterstroke uptime, the core of Lohen's kit.
      </p>
      <div class="mt-4 divide-y divide-slate-800">
        {constellationDetails.map((c) => (
          <div class="py-3">
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-frost-950 px-2.5 py-0.5 text-xs font-bold text-frost-400">{c.c}</span>
              <p class="text-sm font-bold text-slate-100">{c.name}</p>
              <span class="ml-auto rounded-full border border-emerald-800/60 bg-emerald-950/30 px-2.5 py-0.5 text-xs font-semibold text-emerald-400">{c.pct}</span>
            </div>
            <p class="mt-1.5 pl-1 text-sm leading-relaxed text-slate-400">{c.effect}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h3 class="text-lg font-bold text-slate-100">Constellation Value (DPS % per copy)</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        How much each constellation actually improves damage. C1 is the best value per
        primogem; C6 is the capstone but costs five copies. The percentage figures are
        relative to a C0 Lohen in the 6.6 Melt comp, averaged across a full rotation.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-left">
              <th class="py-2 pr-4 font-semibold text-slate-400">Constellation</th>
              <th class="py-2 pr-4 font-semibold text-frost-400">Damage Increase</th>
              <th class="py-2 pr-4 font-semibold text-slate-300">Verdict</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            {constellationDetails.map((c) => (
              <tr>
                <td class="py-2 pr-4 font-semibold text-slate-100">{c.c} · {c.name}</td>
                <td class="py-2 pr-4 text-frost-400">{c.pct}</td>
                <td class="py-2 pr-4 text-xs leading-relaxed text-slate-500">{c.effect}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-slate-500">
        Verdict: stop at C1 unless you are a whale. C1 gives the best damage-per-primogem.
        Prioritize the signature weapon before C2, because Disaster and Remorse provides a
        larger increase than C2 for fewer pulls. Only chase C6 for challenge-mode
        optimization.
      </p>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h3 class="text-lg font-bold text-slate-100">Skill Multipliers at Levels 11-13</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        For players with C3 (+3 Skill), C5 (+3 Normal Attack), or full crowns, the
        multipliers extend beyond level 10. These are the values at 11-13 (with
        constellation bonuses applied).
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-left">
              <th class="py-2 pr-4 font-semibold text-slate-400">Talent</th>
              <th class="py-2 pr-4 font-semibold text-frost-400">Lv. 11</th>
              <th class="py-2 pr-4 font-semibold text-slate-300">Lv. 12</th>
              <th class="py-2 pr-4 font-semibold text-slate-300">Lv. 13</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            {skillLevelsExtended.map((row) => (
              <tr>
                <td class="py-2 pr-4 font-semibold text-slate-100">{row.talent}</td>
                <td class="py-2 pr-4 text-slate-300">{row.lv11}</td>
                <td class="py-2 pr-4 text-slate-300">{row.lv12}</td>
                <td class="py-2 pr-4 text-slate-300">{row.lv13}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-slate-500">
        C3 boosts the Elemental Skill to Lv. 13 (a ~35% multiplier increase over Lv. 10).
        C5 boosts Normal Attack to Lv. 13 (a ~25% increase over Lv. 10). These compound
        with C6's final-hit multiplier, which is why whales crown both before pushing C6.
      </p>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h3 class="text-lg font-bold text-slate-100">Weapon Comparison</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        Side-by-side stats for the three top polearm picks, so you can compare at a
        glance which weapon fits your roster and budget.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[820px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-left">
              <th class="py-3 pr-4 font-semibold text-slate-400">Metric</th>
              <th class="py-3 pr-4 font-semibold text-frost-400">Disaster & Remorse</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Jade Winged-Spear</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Staff of Homa</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Calamity Queller</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Deathmatch</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">White Tassel</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            {weaponCompare.map((row) => (
              <tr>
                <td class="py-3 pr-4 text-slate-400">{row.metric}</td>
                <td class="py-3 pr-4 font-semibold text-slate-100">{row.dr}</td>
                <td class="py-3 pr-4 text-slate-300">{row.jade}</td>
                <td class="py-3 pr-4 text-slate-300">{row.tassel}</td>
                <td class="py-3 pr-4 text-slate-300">{row.homa}</td>
                <td class="py-3 pr-4 text-slate-300">{row.queller}</td>
                <td class="py-3 pr-4 text-slate-300">{row.deathmatch}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
      <h3 class="text-lg font-bold text-slate-100">Best Build by Team Archetype</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        The "best" build changes with your team. The Melt comp wants the BiS artifact set
        for its CRIT bonuses; the Freeze comp can afford Blizzard Strayer and stack CRIT
        DMG; the F2P build trades damage for accessibility. Pick the row that matches your
        roster.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-left">
              <th class="py-3 pr-4 font-semibold text-slate-400">Archetype</th>
              <th class="py-3 pr-4 font-semibold text-frost-400">Weapon</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Set</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Main Stats</th>
              <th class="py-3 pr-4 font-semibold text-slate-300">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            {teamBuilds.map((b) => (
              <tr>
                <td class="py-3 pr-4 font-semibold text-slate-100">{b.archetype}</td>
                <td class="py-3 pr-4 text-slate-300">{b.weapon}</td>
                <td class="py-3 pr-4 text-slate-300">{b.set}</td>
                <td class="py-3 pr-4 text-slate-300">{b.sands} / {b.goblet} / {b.circlet}</td>
                <td class="py-3 pr-4 text-xs leading-relaxed text-slate-500">{b.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
