const goalStats = [
  { k: "CRIT Rate", v: "50%+", note: "42% on artifacts + 8% Cold Front passive during Masterstroke" },
  { k: "CRIT DMG", v: "150%+", note: "Push as high as possible after CRIT Rate hits its target" },
  { k: "ATK", v: "1,800+", note: "Total ATK including weapon and artifacts; do not trade CRIT for it" },
  { k: "Energy Recharge", v: "120-130%", note: "110% with a Cryo battery; enough to Burst every rotation" },
