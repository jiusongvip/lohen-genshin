const artifactStats = [
  { slot: "Sands", main: "ATK%", sub: "CRIT Rate, CRIT DMG, ATK%, Energy Recharge" },
  { slot: "Goblet", main: "Cryo DMG Bonus", sub: "CRIT Rate, CRIT DMG, ATK%, Energy Recharge" },
