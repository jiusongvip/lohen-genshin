---
const facts = [
  { k: "Element", v: "Cryo", icon: "/elements/elem-cryo.webp", alt: "Cryo element icon" },
  { k: "Weapon", v: "Polearm", icon: "/talents/icon-polearm.webp", alt: "Polearm weapon type icon" },
  { k: "Rarity", v: "5-Star" },
  { k: "Constellation", v: "Cuniculus" },
  { k: "Title", v: "Vice Captain, Favonius Fifth Company" },
  { k: "Region", v: "Mondstadt" },
  { k: "Affiliation", v: "Knights of Favonius" },
  { k: "Release", v: "6.6, May 20, 2026" },
  { k: "Birthday", v: "April 3" },
  { k: "Story Quest", v: "Cuniculus Chapter" },
];
const voiceActors = "EN Nick Wolfhard · CN Lin Jingnan · JP Amasaki Kohei";
const role = "On-field Main DPS";
const tierList = "Tier: S (Melt comp) · A (Freeze/Mono Cryo)";
const portrait = "/portraits/hero.webp";
const portraitW = 750;
const portraitH = 1800;
---

<section id="top" class="hero-stage">
  <div class="hero-bg" aria-hidden="true">
    <div
      class="absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, #3aa7c4 0%, transparent 70%)"
    ></div>
    <div
      class="absolute -bottom-32 -left-32 h-[26rem] w-[26rem] rounded-full opacity-30 blur-3xl"
      style="background: radial-gradient(circle, #8fc2e8 0%, transparent 70%)"
    ></div>
  </div>
  <canvas class="hero-particles" id="hero-particles" aria-hidden="true"></canvas>

  <div class="hero-content">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1fr] lg:gap-14">
      <div class="text-center lg:text-left">
        <p class="overline">Genshin Impact · Version 6.6 · Updated August 2026</p>
        <h1 id="hero-title" class="hero-title text-6xl sm:text-7xl lg:text-8xl">
          <span id="hero-name" class="block">Lohen</span>
          <span class="mt-3 block font-sans text-base font-semibold uppercase tracking-[0.18em] text-frost-600 sm:text-lg">
            Genshin Impact Character Guide
          </span>
        </h1>
        <p class="hero-sub text-base leading-relaxed md:text-lg">
          <span class="font-accent text-2xl font-semibold italic text-frost-700 md:text-3xl">
            The Aggressive Vanguard.
          </span>
          <span class="mt-2 block">
            A 5-star Cryo polearm user who builds Joy and Will to Win, then enters the
            Masterstroke state to unleash Hexerei chains. One page. Every answer. No ten tabs, no
            login wall, no top-up ads.
          </span>
        </p>

        <div class="mt-9 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href="#build" class="btn-ink">Best Build</a>
          <a href="#pull" class="btn-outline btn-outline-dark">Should you pull?</a>
        </div>

        <p class="hero-meta">
          <span>By Eira Vanguard</span>
          <span aria-hidden="true">·</span>
          <span>Adventure Rank 60</span>
          <span aria-hidden="true">·</span>
          <span>59-question FAQ</span>
        </p>
      </div>

      <div class="mx-auto hidden w-full max-w-sm sm:block lg:max-w-md">
        <img
          src={portrait}
          alt="Lohen character portrait — the Vice Captain of the Knights of Favonius Fifth Company, wielding his polearm with Cryo frost"
          width={portraitW}
          height={portraitH}
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-2xl border border-stone-700/60 shadow-[0_30px_80px_-24px_rgba(29,27,23,0.45)]"
        />
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true"></div>
</section>

<section
  id="dossier"
  aria-label="Lohen character dossier"
  class="relative z-10 mx-auto -mt-12 max-w-6xl px-4 sm:px-6"
>
  <div class="rounded-2xl border border-stone-800 bg-white/80 p-6 shadow-[0_18px_60px_-24px_rgba(29,27,23,0.25)] backdrop-blur-md sm:p-8">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-5">
      {facts.map((f) => (
        <div>
          <dt class="overline text-xs">{f.k}</dt>
          <dd class="mt-1 flex items-center gap-2 text-sm font-semibold text-stone-100">
            {f.icon && (
              <img
                src={f.icon}
                alt={f.alt}
                width="256"
                height="256"
                loading="lazy"
                decoding="async"
                class="h-5 w-5 shrink-0 rounded border border-stone-700/50 bg-white/60"
              />
            )}
            {f.v}
          </dd>
        </div>
      ))}
    </dl>
    <div class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1 border-t border-stone-800/70 pt-5">
      <span class="overline text-xs">Voice Actors</span>
      <span class="text-sm font-semibold text-stone-100">{voiceActors}</span>
    </div>
    <div class="mt-6 border-t border-stone-800/70 pt-5">
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
        <p class="overline text-xs">Role &amp; Tier</p>
        <p class="text-sm font-semibold text-stone-100">{role}</p>
        <p class="text-sm font-semibold">
          <span class="text-gold-600">Tier: S</span>
          <span class="text-stone-400"> (Melt comp)</span>
          <span class="text-frost-600"> · A</span>
          <span class="text-stone-400"> (Freeze/Mono Cryo)</span>
        </p>
      </div>
    </div>
    <div class="mt-6 border-t border-stone-800/70 pt-5">
      <p class="overline text-xs">Max Stats (Lv. 90)</p>
      <div class="mt-3 grid grid-cols-5 gap-3 text-center">
        <div>
          <p class="text-xs text-stone-500">HP</p>
          <p class="mt-1 text-sm font-semibold text-stone-100">13,108</p>
        </div>
        <div>
          <p class="text-xs text-stone-500">ATK</p>
          <p class="mt-1 text-sm font-semibold text-stone-100">352</p>
        </div>
        <div>
          <p class="text-xs text-stone-500">DEF</p>
          <p class="mt-1 text-sm font-semibold text-stone-100">799</p>
        </div>
        <div>
          <p class="text-xs text-stone-500">CRIT Rate</p>
          <p class="mt-1 text-sm font-semibold text-stone-100">5.0%</p>
        </div>
        <div>
          <p class="text-xs text-stone-500">CRIT DMG</p>
          <p class="mt-1 text-sm font-semibold text-stone-100">50.0%</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var nameEl = document.getElementById("hero-name");
    if (nameEl && !reduce) {
      var text = nameEl.textContent || "";
      nameEl.textContent = "";
      var frag = document.createDocumentFragment();
      text.split("").forEach(function (ch) {
        var s = document.createElement("span");
        s.className = "split-char";
        s.textContent = ch === " " ? "\u00a0" : ch;
        frag.appendChild(s);
      });
      nameEl.appendChild(frag);
      var spans = nameEl.querySelectorAll(".split-char");
      spans.forEach(function (s, i) {
        s.style.transitionDelay = (0.35 + i * 0.045).toFixed(3) + "s";
      });
      requestAnimationFrame(function () {
        setTimeout(function () {
          spans.forEach(function (s) { s.classList.add("in"); });
        }, 80);
      });
    }

    var canvas = document.getElementById("hero-particles");
    if (canvas && !reduce) {
      var ctx = canvas.getContext("2d");
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var w, h, particles = [];
      var colors = ["rgba(42,147,179,", "rgba(67,176,204,", "rgba(124,201,221,", "rgba(143,194,232,"];

      function resize() {
        var rect = canvas.parentElement.getBoundingClientRect();
        w = rect.width; h = rect.height;
        canvas.width = w * dpr; canvas.height = h * dpr;
        canvas.style.width = w + "px"; canvas.style.height = h + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function spawn(p) {
        p.x = Math.random() * w;
        p.y = h + 6;
        p.r = 0.6 + Math.random() * 2;
        p.vy = -(0.1 + Math.random() * 0.32);
        p.vx = (Math.random() - 0.5) * 0.14;
        p.a = 0.08 + Math.random() * 0.2;
        p.c = colors[Math.floor(Math.random() * colors.length)];
        p.tw = Math.random() * Math.PI * 2;
      }
      function init() {
        resize();
        var count = Math.min(46, Math.floor(w / 30));
        particles = [];
        for (var i = 0; i < count; i++) { var p = {}; spawn(p); p.y = Math.random() * h; particles.push(p); }
      }
      function frame() {
        ctx.clearRect(0, 0, w, h);
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.x += p.vx; p.y += p.vy; p.tw += 0.008;
          p.a = 0.08 + Math.random() * 0.16;
          if (p.y < -12) spawn(p);
          if (p.x < -12) p.x = w + 12; if (p.x > w + 12) p.x = -12;
          ctx.beginPath();
          ctx.fillStyle = p.c + (p.a * (0.5 + 0.5 * Math.sin(p.tw))).toFixed(3) + ")";
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        requestAnimationFrame(frame);
      }
      init();
      requestAnimationFrame(frame);
      var onResize;
      window.addEventListener("resize", function () { clearTimeout(onResize); onResize = setTimeout(init, 200); }, { passive: true });
    }
  })();
</script>
