---
// Competitor comparison: Lohen vs the two closest Cryo polearm/main DPS units.
// Qualitative ratings plus a team-archetype overview so readers can pick based on value.
const dims = [
  { d: "Role", lohen: "Front-line Cryo main DPS", rosaria: "Cryo support / sub DPS", ganyu: "Ranged Cryo main DPS" },
  { d: "Melt synergy", lohen: "Excellent", rosaria: "Good", ganyu: "Excellent" },
  { d: "Survivability", lohen: "Medium", rosaria: "Medium", ganyu: "Low (ranged)" },
  { d: "Constellation value", lohen: "C1 high", rosaria: "C6 high", ganyu: "C0 fine" },
  { d: "F2P friendliness", lohen: "High", rosaria: "Very high", ganyu: "Medium" },
  { d: "Best home", lohen: "6.6 Melt (Durin + Nicole)", rosaria: "Reverse Melt / battery", ganyu: "Freeze / Melt" },
];

const teamRatings = [
  { team: "6.6 Melt (Durin + Nicole)", st: "S", aoe: "A", comfort: "B", f2p: "D", note: "Highest single-target ceiling; requires Durin and Nicole." },
  { team: "F2P Melt (Xiangling)", st: "A", aoe: "A", comfort: "B", f2p: "S", note: "Best F2P value; only requires Lohen himself." },
  { team: "Freeze (Kokomi + Kazuha)", st: "B", aoe: "S", comfort: "S", f2p: "C", note: "Safest and best for many small mobs." },
  { team: "Mono Cryo (Ganyu + Shenhe)", st: "B", aoe: "A", comfort: "B", f2p: "D", note: "Best against non-Cryo enemies without Pyro enablers." },
  { team: "Reverse Melt (Rosaria + Xiangling)", st: "A", aoe: "A", comfort: "C", f2p: "B", note: "Balances team damage; less spikey than front-loaded Melt." },
  { team: "Physical (Fischl)", st: "C", aoe: "C", comfort: "B", f2p: "S", note: "Niche; only for physical-themed content." },
];
---

<section id="compare" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Lohen vs Rosaria vs Ganyu
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-400">
      The three most common Cryo main DPS comparisons. Lohen wins on Melt synergy and front-loaded
      burst, Ganyu wins on ranged safety, and Rosaria wins on support value and accessibility.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="flex items-center gap-4 rounded-xl border border-stone-800 bg-stone-900/30 p-4">
        <img src="/portraits/lohen-card.webp" alt="Lohen portrait" width="1500" height="1500" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-full border border-stone-700/60 bg-white/60" />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-bold text-stone-100">Lohen</p>
          <p class="text-xs text-stone-500">Front-line Cryo DPS</p>
        </div>
      </div>
      <div class="flex items-center gap-4 rounded-xl border border-stone-800 bg-stone-900/30 p-4">
        <img src="/chars/char-rosaria.webp" alt="Rosaria portrait" width="256" height="256" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-full border border-stone-700/60 bg-white/60" />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-bold text-stone-100">Rosaria</p>
          <p class="text-xs text-stone-500">Cryo support / sub DPS</p>
        </div>
      </div>
      <div class="flex items-center gap-4 rounded-xl border border-stone-800 bg-stone-900/30 p-4">
        <img src="/chars/char-ganyu.webp" alt="Ganyu portrait" width="256" height="256" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-full border border-stone-700/60 bg-white/60" />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-bold text-stone-100">Ganyu</p>
          <p class="text-xs text-stone-500">Ranged Cryo main DPS</p>
        </div>
      </div>
    </div>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[36rem] border-collapse text-sm">
        <thead>
          <tr class="text-left">
            <th class="py-3 pr-4 font-medium text-stone-500">Dimension</th>
            <th class="px-4 py-3 font-semibold text-frost-400">Lohen</th>
            <th class="px-4 py-3 font-semibold text-stone-200">Rosaria</th>
            <th class="px-4 py-3 font-semibold text-stone-200">Ganyu</th>
          </tr>
        </thead>
        <tbody>
          {dims.map((row, i) => (
            <tr class={i === dims.length - 1 ? "" : "border-b border-stone-800/70"}>
              <td class="py-4 pr-4 text-stone-400">{row.d}</td>
              <td class="px-4 py-4 text-stone-100">{row.lohen}</td>
              <td class="px-4 py-4 text-stone-300">{row.rosaria}</td>
              <td class="px-4 py-4 text-stone-300">{row.ganyu}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
      <p class="text-sm leading-relaxed text-stone-300">
        <span class="font-semibold text-stone-100">Bottom line:</span> Lohen is not a direct
        replacement for either. Ganyu is ranged and safer, Rosaria is a support/battery, and Lohen
        is a front-line main DPS whose Hexerei chains shine in the 6.6 Melt comp with Durin and
        Nicole. If you already own a built Cryo main DPS, Lohen reads as a sidegrade rather than an
        upgrade.
      </p>
    </div>

    <div class="mt-10">
      <h3 class="text-xl font-bold tracking-tight text-stone-50">
        Team Archetype Ratings
      </h3>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-400">
        A quick rating across the six viable archetypes, so you can pick based on what you value
        most: single-target damage, AoE, comfort, or budget. S = top tier, A = strong, B = good,
        C = niche, D = poor.
      </p>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-sm">
          <thead>
            <tr class="text-left">
              <th class="py-3 pr-4 font-medium text-stone-500">Team</th>
              <th class="px-4 py-3 font-medium text-stone-500">Single-Target</th>
              <th class="px-4 py-3 font-medium text-stone-500">AoE</th>
              <th class="px-4 py-3 font-medium text-stone-500">Comfort</th>
              <th class="px-4 py-3 font-medium text-stone-500">F2P</th>
              <th class="px-4 py-3 font-medium text-stone-500">Notes</th>
            </tr>
          </thead>
          <tbody>
            {teamRatings.map((t, i) => (
              <tr class={i === teamRatings.length - 1 ? "" : "border-b border-stone-800/70"}>
                <td class="py-4 pr-4 font-semibold text-stone-100">{t.team}</td>
                <td class={`px-4 py-4 font-bold ${t.st === "S" ? "text-gold-600" : "text-frost-600"}`}>{t.st}</td>
                <td class="px-4 py-4 text-stone-300">{t.aoe}</td>
                <td class="px-4 py-4 text-stone-300">{t.comfort}</td>
                <td class="px-4 py-4 text-stone-300">{t.f2p}</td>
                <td class="px-4 py-4 text-xs leading-relaxed text-stone-400">{t.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
