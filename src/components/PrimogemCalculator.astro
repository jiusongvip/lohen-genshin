---
// Primogem budget calculator. Uses Genshin's official pity rules (90 hard pity, 74+ soft
// pity, 50/50 into guaranteed). Renders a static default result in the initial HTML; the
// script upgrades it into an interactive calculator.
const constellations = [
  { value: "0", label: "C0 (1 copy)" },
  { value: "1", label: "C1 (2 copies)" },
  { value: "2", label: "C2 (3 copies)" },
  { value: "6", label: "C6 (7 copies)" },
];
---

<section id="budget" class="reveal border-b border-stone-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-stone-50 sm:text-4xl">
      Primogem Budget Calculator
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-400">
      Estimate how many Primogems you still need to pull the Lohen copies you want. Figures use
      a 90-pull hard pity, a 74-pull soft pity start, and the 50/50 into guaranteed mechanic.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="space-y-5 rounded-2xl border border-stone-800 bg-stone-900/40 p-6">
        <div>
          <label for="primos" class="block text-sm font-medium text-stone-200">
            Primogems you have
          </label>
          <input
            id="primos"
            type="number"
            min="0"
            step="160"
            value="0"
            class="mt-2 w-full rounded-xl border border-stone-700 bg-stone-950 px-4 py-3.5 text-base text-stone-100 outline-none transition-colors focus:border-frost-500"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label for="pity" class="text-sm font-medium text-stone-200">
              Pity counter (pulls since last 5-star)
            </label>
            <span id="pity-value" class="font-mono text-sm text-frost-400">0</span>
          </div>
          <input
            id="pity"
            type="range"
            min="0"
            max="89"
            value="0"
            class="mt-3 w-full accent-frost-500"
          />
          <p class="mt-1 text-xs text-stone-500">74 or more means you are in soft pity.</p>
        </div>

        <div>
          <label for="const" class="block text-sm font-medium text-stone-200">
            Target constellation
          </label>
          <select
            id="const"
            class="mt-2 w-full rounded-xl border border-stone-700 bg-stone-950 px-4 py-3.5 text-base text-stone-100 outline-none transition-colors focus:border-frost-500"
          >
            {constellations.map((c) => (
              <option value={c.value}>{c.label}</option>
            ))}
          </select>
        </div>

        <label class="flex cursor-pointer items-center gap-3 text-base text-stone-300">
          <input
            id="guaranteed"
            type="checkbox"
            class="h-5 w-5 accent-frost-500"
          />
          I lost my last 50/50 (guaranteed next 5-star is the featured character)
        </label>
      </div>

      <div
        id="budget-result"
        class="flex flex-col justify-center rounded-2xl border border-frost-700/40 bg-frost-950/20 p-8"
      >
        <p class="text-xs font-semibold uppercase tracking-wide text-frost-400">
          Estimated requirement
        </p>
        <p class="mt-4 text-3xl font-extrabold tracking-tight text-stone-50">
          <span id="result-expect">15,000</span>
          <span class="text-base font-medium text-stone-400"> Primogems</span>
        </p>
        <p class="mt-2 text-sm text-stone-400">
          Expected cost. Worst case is about
          <span id="result-worst" class="font-semibold text-stone-200">28,800</span>
          Primogems.
        </p>
        <p id="result-verdict" class="mt-5 rounded-xl bg-stone-950/60 p-4 text-sm leading-relaxed text-stone-300">
          You are short. You still need about 15,000 Primogems on average.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const COST_PER_PULL = 160;
  const HARD_PITY = 90;
  const EXPECTED_FIVE_STAR = 62.5;
  const EXPECTED_FEATURED = 93.75;

  const primosEl = document.getElementById("primos") as HTMLInputElement;
  const pityEl = document.getElementById("pity") as HTMLInputElement;
  const pityValueEl = document.getElementById("pity-value") as HTMLElement;
  const constEl = document.getElementById("const") as HTMLSelectElement;
  const guaranteedEl = document.getElementById("guaranteed") as HTMLInputElement;
  const resultExpectEl = document.getElementById("result-expect") as HTMLElement;
  const resultWorstEl = document.getElementById("result-worst") as HTMLElement;
  const resultVerdictEl = document.getElementById("result-verdict") as HTMLElement;

  function format(n: number): string {
    return Math.max(0, Math.round(n)).toLocaleString("en-US");
  }

  function compute() {
    const have = Number(primosEl.value) || 0;
    const pity = Number(pityEl.value) || 0;
    const copies = Number(constEl.value) + 1;
    const guaranteed = guaranteedEl.checked;

    let firstExpect: number;
    let firstWorst: number;
    if (guaranteed) {
      firstExpect = Math.max(1, EXPECTED_FIVE_STAR - pity);
      firstWorst = Math.max(1, HARD_PITY - pity);
    } else {
      firstExpect = Math.max(1, EXPECTED_FEATURED - pity);
      firstWorst = Math.max(1, HARD_PITY * 2 - pity);
    }

    const restExpect = EXPECTED_FEATURED * (copies - 1);
    const restWorst = HARD_PITY * 2 * (copies - 1);

    const totalExpect = (firstExpect + restExpect) * COST_PER_PULL;
    const totalWorst = (firstWorst + restWorst) * COST_PER_PULL;

    const needExpect = totalExpect - have;
    const needWorst = totalWorst - have;

    resultExpectEl.textContent = format(totalExpect);
    resultWorstEl.textContent = format(totalWorst);

    if (have >= totalWorst) {
      resultVerdictEl.textContent =
        "You are fully covered, even in the worst case. Pull with confidence.";
    } else if (have >= totalExpect) {
      resultVerdictEl.textContent =
        "You are covered on average. If you lose a 50/50 you may still come up short.";
    } else {
      resultVerdictEl.textContent =
        `You are short. You still need about ${format(needExpect)} Primogems on average, ` +
        `and ${format(needWorst)} in the worst case.`;
    }
  }

  function syncPity() {
    pityValueEl.textContent = pityEl.value;
    compute();
  }

  pityEl.addEventListener("input", syncPity);
  primosEl.addEventListener("input", compute);
  constEl.addEventListener("change", compute);
  guaranteedEl.addEventListener("change", compute);
</script>
