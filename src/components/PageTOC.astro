---
const items = [
  { href: "#summary", label: "At a Glance" },
  { href: "#pull", label: "Should You Pull?" },
  { href: "#budget", label: "Primogem Calculator" },
  { href: "#build", label: "Build" },
  { href: "#compare", label: "Compare" },
  { href: "#howto", label: "How to Play" },
  { href: "#lore", label: "Lore" },
  { href: "#materials", label: "Materials" },
  { href: "#faq", label: "FAQ" },
  { href: "#trust", label: "Trust & Sources" },
];
---

<aside
  id="page-toc"
  class="page-toc fixed right-6 top-24 z-40 hidden w-60 xl:block"
  aria-label="On this page"
>
  <div class="rounded-2xl border border-stone-800 bg-stone-900/85 p-5 shadow-[0_16px_44px_-18px_rgba(0,0,0,0.7)] backdrop-blur-md">
    <p class="overline text-sm font-bold">On this page</p>
    <ol class="mt-3 space-y-1 border-l-2 border-stone-700 pl-4">
      {items.map((i) => (
        <li>
          <a href={i.href} class="block rounded-md py-1.5 text-[0.95rem] leading-snug">
            {i.label}
          </a>
        </li>
      ))}
    </ol>
  </div>
</aside>
