---
// Material calculator: interactive tool that outputs totals based on a target
// level. Static default renders in initial HTML for crawlers; inline script
// upgrades it.
const levelOptions = ["70", "80", "90"];
const talentOptions = ["6", "8", "10"];

const base = {
  70: { resin: 1320, mora: 1280000, days: 7 },
  80: { resin: 1760, mora: 1720000, days: 9 },
  90: { resin: 2180, mora: 2400000, days: 12 },
};

const talentBase = {
  6: { resin: 120, mora: 280000 },
  8: { resin: 240, mora: 620000 },
  10: { resin: 360, mora: 1200000 },
};
---

<section id="calc" class="border-b border-slate-800/70 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
      Lohen Material Calculator
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-400">
      Pick your target level and talent level to estimate the total resin, Mora, and
      farming days. Plan your pre-farming before the banner goes live.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-6">
        <div class="space-y-6">
          <div>
            <label for="calc-level" class="text-sm font-semibold text-slate-100">
              Target character level
            </label>
            <div class="mt-3 flex flex-wrap gap-2">
              {levelOptions.map((lv) => (
                <button
                  type="button"
                  data-level={lv}
                  class="calc-level rounded-full border border-slate-700 px-4 py-2 text-sm text-slate-300 transition-colors hover:border-frost-500"
                >
                  Lv. {lv}
                </button>
              ))}
            </div>
          </div>
          <div>
            <label for="calc-talent" class="text-sm font-semibold text-slate-100">
              Target talent level
            </label>
            <div class="mt-3 flex flex-wrap gap-2">
              {talentOptions.map((lv) => (
                <button
                  type="button"
                  data-talent={lv}
                  class="calc-talent rounded-full border border-slate-700 px-4 py-2 text-sm text-slate-300 transition-colors hover:border-frost-500"
                >
                  Lv. {lv}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div
        id="calc-output"
        class="flex flex-col justify-center rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-6 sm:p-8"
      >
        <p class="text-sm font-medium uppercase tracking-[0.12em] text-slate-500">
          Estimated cost
        </p>
        <div class="mt-4 grid grid-cols-3 gap-4 text-center">
          <div>
            <p class="text-xs text-slate-500">Resin</p>
            <p id="calc-resin" class="mt-1 text-2xl font-bold text-frost-400">3,260</p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Mora</p>
            <p id="calc-mora" class="mt-1 text-2xl font-bold text-frost-400">6.0M</p>
          </div>
          <div>
            <p class="text-xs text-slate-500">Days</p>
            <p id="calc-days" class="mt-1 text-2xl font-bold text-frost-400">12</p>
          </div>
        </div>
        <p id="calc-note" class="mt-5 text-xs leading-relaxed text-slate-500">
          Defaults: Lv. 90 character, Lv. 10 talents (all three). Resin includes
          ascension (2,180) plus three talents (360 each). Estimates only.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ base, talentBase }}>
  let level = "90";
  let talent = "10";

  const levelBtns = document.querySelectorAll(".calc-level");
  const talentBtns = document.querySelectorAll(".calc-talent");

  function setActive(btns, value) {
    btns.forEach((b) => {
      const active = b.dataset.level === value || b.dataset.talent === value;
      b.classList.toggle("border-frost-500", active);
      b.classList.toggle("bg-frost-950", active);
      b.classList.toggle("text-frost-300", active);
    });
  }

  function render() {
    const l = base[level] || base["90"];
    const t = talentBase[talent] || talentBase["10"];
    const resin = l.resin + t.resin * 3;
    const mora = l.mora + t.mora * 3;
    const days = l.days;
    document.getElementById("calc-resin").textContent = resin.toLocaleString();
    document.getElementById("calc-mora").textContent =
      mora >= 1000000 ? (mora / 1000000).toFixed(1) + "M" : mora.toLocaleString();
    document.getElementById("calc-days").textContent = days;
    document.getElementById("calc-note").textContent =
      "Lv. " + level + " character, Lv. " + talent + " talents (all three). " +
      "Resin includes ascension (" + l.resin.toLocaleString() + ") plus " +
      "three talents (" + (t.resin * 3).toLocaleString() + " total). Estimates only.";
  }

  levelBtns.forEach((b) =>
    b.addEventListener("click", () => {
      level = b.dataset.level;
      setActive(levelBtns, level);
      render();
    })
  );
  talentBtns.forEach((b) =>
    b.addEventListener("click", () => {
      talent = b.dataset.talent;
      setActive(talentBtns, talent);
      render();
    })
  );

  setActive(levelBtns, level);
  setActive(talentBtns, talent);
</script>
