---
import "@fontsource-variable/outfit";
import "../styles/global.css";
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import outfitLatinExt from "@fontsource-variable/outfit/files/outfit-latin-ext-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical: string;
  faqs?: { q: string; a: string }[];
  noindex?: boolean;
}

const { title, description, canonical, faqs = [], noindex = false } = Astro.props;
const site = "https://www.lohen-genshin.com";
const ogImage = `${site}/og.webp`;

const publisherSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Lohen Genshin Guide",
  url: site,
  logo: `${site}/favicon.png`,
};

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Eira Vanguard",
  url: `${site}/#author`,
  jobTitle: "Independent Genshin Impact Guide Author",
  knowsAbout: ["Genshin Impact", "Lohen", "Genshin Impact character builds", "Genshin Impact team compositions"],
  description:
    "Active Genshin Impact player (Adventure Rank 60, 1,800+ hours) who tests characters at multiple constellations across Melt, Freeze, and Mono Cryo teams.",
};

const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Genshin Impact",
  url: "https://genshin.hoyoverse.com/",
  gamePlatform: ["Windows", "PlayStation 4", "PlayStation 5", "iOS", "Android"],
  applicationCategory: "Game",
  publisher: {
    "@type": "Organization",
    name: "HoYoverse",
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "en",
  datePublished: "2026-05-20",
  dateModified: "2026-08-28",
  isPartOf: {
    "@type": "WebSite",
    name: "Lohen Genshin Guide",
    url: site,
  },
  about: {
    "@type": "VideoGame",
    name: "Genshin Impact",
  },
  author: {
    "@type": "Person",
    name: "Eira Vanguard",
    url: `${site}/#author`,
  },
  publisher: {
    "@type": "Organization",
    name: "Lohen Genshin Guide",
    url: site,
  },
};

const faqSchema =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: f.a,
          },
        })),
      }
    : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Lohen Guide",
      item: site,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/hero-visual.webp" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href={outfitLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={outfitLatinExt} crossorigin />
    <link rel="indexnow" href="/4e1f2c3d4a5b6789f0a1.txt" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Eira Vanguard" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lohen Genshin Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(videoGameSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(publisherSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
        {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
      </>
    )}
  </head>
  <body class="min-h-[100dvh] bg-slate-950 text-slate-200 antialiased">
    <header class="sticky top-0 z-50 border-b border-slate-800/70 bg-slate-950/85 backdrop-blur-md">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="#top" class="flex items-center gap-2" aria-label="Lohen Genshin Guide home">
          <span class="h-2.5 w-2.5 rounded-full bg-frost-500" aria-hidden="true"></span>
          <span class="text-base font-bold tracking-tight text-slate-50">Lohen Guide</span>
        </a>
        <div class="flex items-center gap-4 text-sm text-slate-400 sm:gap-6">
          <a href="#mechanics" class="transition-colors hover:text-frost-400">Mechanics</a>
          <a href="#combo" class="hidden transition-colors hover:text-frost-400 lg:inline">
            Combo
          </a>
          <a href="#build" class="transition-colors hover:text-frost-400">Build</a>
          <a href="#teams" class="hidden transition-colors hover:text-frost-400 sm:inline">
            Teams
          </a>
          <a href="#calc" class="hidden transition-colors hover:text-frost-400 md:inline">
            Calculators
          </a>
          <a href="#faq" class="transition-colors hover:text-frost-400">FAQ</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="border-t border-slate-800/70 py-10">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
          <div class="max-w-md">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-frost-500" aria-hidden="true"></span>
              <span class="text-sm font-bold text-slate-50">Lohen Genshin Guide</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">
              A fan-made reference covering Lohen's mechanics, build, teams, and materials.
              Not affiliated with or endorsed by HoYoverse or miHoYo. All game assets and
              trademarks belong to their respective owners.
            </p>
          </div>
          <div class="text-sm text-slate-500">
            <p>&copy; 2026 Lohen Genshin Guide. All rights reserved.</p>
            <p class="mt-2">
              <a href="mailto:contact@lohen-genshin.com" class="transition-colors hover:text-frost-400">
                contact@lohen-genshin.com
              </a>
            </p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600">
              This site uses no cookies, runs no trackers, and collects no personal data.
              It is a fan-made reference; Genshin Impact and all related trademarks belong
              to their respective owners. Spot an error or outdated stat? Email
              <a href="mailto:contact@lohen-genshin.com" class="text-frost-500 transition-colors hover:text-frost-400">
                contact@lohen-genshin.com
              </a>
              and it will be corrected with a changelog note.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
