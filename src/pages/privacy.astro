---
import Layout from "../layouts/Layout.astro";

const title = "Privacy Policy — Lohen Genshin Guide (Cookies & Analytics)";
const description =
  "How the Lohen Genshin Guide handles your data: anonymous Google Analytics usage stats, no personal information collected, and how to opt out.";
const canonical = "https://www.lohen-genshin.com/privacy/";
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 pb-24 pt-32 sm:px-6">
    <p class="overline">Privacy</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Privacy policy</h1>
    <div class="mt-8 space-y-5 text-base leading-relaxed text-stone-300">
      <p>
        <span class="font-semibold text-stone-100">Short version:</span> this site sets no
        advertising cookies, runs no third-party ad trackers, and collects no personal information.
        We do use privacy-respecting analytics (Google Analytics 4 and Cloudflare Web Analytics) to
        understand aggregate traffic — which pages are read and roughly how many visitors arrive.
        Your IP address is anonymized before it is stored, and nothing links a visit to your
        identity.
      </p>
      <h2 class="mt-10 text-2xl">What we collect</h2>
      <p>
        Only aggregate, anonymized usage statistics: pages viewed, approximate country, browser and
        device type, and a referrer. These are processed by Google Analytics 4 and Cloudflare Web
        Analytics on our behalf to guide what we write. We do not sell data, run advertising
        networks, or build cross-site profiles. Our hosting provider's servers also log standard
        request metadata (IP address, user agent, requested URL) briefly for security, which is
        outside our control.
      </p>
      <h2 class="mt-10 text-2xl">Opting out</h2>
      <p>
        You can stop analytics collection without leaving the site by installing the official
        <a
          href="https://tools.google.com/dlpage/gaoptout/"
          target="_blank"
          rel="noopener"
          class="text-frost-600 underline decoration-stone-700 underline-offset-4"
          >Google Analytics opt-out browser add-on</a
        >. Blocking the
        <code class="rounded bg-stone-900 px-1.5 py-0.5 text-sm">googletagmanager.com</code> and
        <code class="rounded bg-stone-900 px-1.5 py-0.5 text-sm">cloudflareinsights.com</code>
        domains in any privacy blocker has the same effect. Core reading works fine with all
        analytics blocked.
      </p>
      <h2 class="mt-10 text-2xl">Contact</h2>
      <p>
        If you email us, we see only the address you write from and the contents of your message,
        and we use them solely to reply. Email us at
        <a href="mailto:contact@lohen-genshin.com" class="text-frost-600 underline decoration-stone-700 underline-offset-4">
          contact@lohen-genshin.com
        </a>.
      </p>
      <h2 class="mt-10 text-2xl">Changes</h2>
      <p>
        If this policy ever changes, the update date below will be revised. Last updated: September
        21, 2026.
      </p>
    </div>
  </main>
</Layout>
