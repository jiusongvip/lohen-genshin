---
import Layout from "../layouts/Layout.astro";

const title = "Privacy Policy — Lohen Genshin Guide";
const description =
  "Lohen Genshin Guide's privacy policy: no cookies, no tracking, no personal data collected.";
const canonical = "https://www.lohen-genshin.com/privacy/";
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 pb-24 pt-32 sm:px-6">
    <p class="overline">Privacy</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Privacy policy</h1>
    <div class="mt-8 space-y-5 text-base leading-relaxed text-stone-300">
      <p>
        <span class="font-semibold text-stone-100">Short version:</span> this site uses no cookies,
        no tracking scripts, no analytics beacons, and collects no personal data. Reading it is
        like reading a printed page.
      </p>
      <h2 class="mt-10 text-2xl">What we collect</h2>
      <p>
        Nothing. We do not set cookies, do not run third-party trackers or advertising, and do not
        process personal information. Our hosting provider's servers log standard request metadata
        (IP address, user agent, requested URL) for security and traffic purposes, which is
        retained briefly and is outside our control.
      </p>
      <h2 class="mt-10 text-2xl">Contact</h2>
      <p>
        If you email us, we see only the address you write from and the contents of your message,
        and we use them solely to reply. Email us at
        <a href="mailto:contact@lohen-genshin.com" class="text-frost-600 underline decoration-stone-700 underline-offset-4">
          contact@lohen-genshin.com
        </a>.
      </p>
      <h2 class="mt-10 text-2xl">Changes</h2>
      <p>
        If this policy ever changes, the update date below will be revised. Last updated: August
        28, 2026.
      </p>
    </div>
  </main>
</Layout>
