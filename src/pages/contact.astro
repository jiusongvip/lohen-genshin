---
import Layout from "../layouts/Layout.astro";

const title = "Contact the Lohen Genshin Guide: Corrections & Feedback";
const description =
  "Get in touch with the Lohen Genshin Guide team to report corrections, share missing team comps, or submit sources that change a build recommendation.";
const canonical = "https://www.lohen-genshin.com/contact/";
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 pb-24 pt-32 sm:px-6">
    <p class="overline">Contact</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Found an error? Tell us.</h1>
    <div class="mt-8 space-y-5 text-base leading-relaxed text-stone-300">
      <p>
        We update the guide every version, but theorycrafting moves fast. If you have a corrected
        number, a missing team comp, or a source that changes a recommendation, we want to hear
        about it.
      </p>
      <div class="mt-8 rounded-2xl border border-stone-800 bg-stone-900/60 p-6">
        <p class="overline text-xs">Email</p>
        <p class="mt-2 text-lg font-semibold text-stone-100">
          <a href="mailto:contact@lohen-genshin.com" class="underline decoration-stone-700 underline-offset-4 transition-colors hover:text-frost-600">
            contact@lohen-genshin.com
          </a>
        </p>
        <p class="mt-3 text-sm text-stone-400">
          Please include the section and the figure you believe is wrong, plus a source or in-game
          screenshot if you have one. We typically reply within a few days.
        </p>
      </div>
      <p class="mt-8 text-sm text-stone-500">
        This is a fan project with no affiliation to HoYoverse. We cannot help with account
        recovery, bug reports or billing — please contact HoYoverse support directly.
      </p>
    </div>
  </main>
</Layout>
