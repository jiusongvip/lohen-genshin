---
import Layout from "../layouts/Layout.astro";

const title = "Terms of Use — Lohen Genshin Guide (Unofficial Fan Guide)";
const description =
  "The rules for using the Lohen Genshin Guide: it is unofficial fan content, not affiliated with HoYoverse, and all Genshin Impact marks belong to their owner.";
const canonical = "https://www.lohen-genshin.com/terms/";
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 pb-24 pt-32 sm:px-6">
    <p class="overline">Legal</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Terms of use</h1>
    <div class="mt-8 space-y-5 text-base leading-relaxed text-stone-300">
      <p>
        <span class="font-semibold text-stone-100">Short version:</span> this is an independent,
        fan-made guide. Use it freely to build your character, but know that it has no official
        relationship with the game's owners and makes no guarantees about in-game results.
      </p>

      <h2 class="mt-10 text-2xl">Unofficial fan content</h2>
      <p>
        Lohen Genshin Guide is a hobby project written and maintained by fans. It is not
        affiliated with, endorsed by, or sponsored by HoYoverse or miHoYo. All game names,
        characters, logos, artwork references, and trademarks mentioned here (including
        <span class="text-stone-100">Genshin Impact</span> and the character
        <span class="text-stone-100">Lohen</span>) are the property of HoYoverse and are used only
        for identification and commentary.
      </p>

      <h2 class="mt-10 text-2xl">Using this site</h2>
      <p>
        You are welcome to read, share, and link to any page here. Build recommendations, team
        comps, rotation advice, and pull guidance reflect the author's testing and opinion at the
        time of writing. Genshin Impact changes with every version, so numbers and advice can go
        out of date — always confirm against the in-game menus before spending resources.
      </p>

      <h2 class="mt-10 text-2xl">No warranty</h2>
      <p>
        The content is provided "as is", without warranty of any kind. We are not responsible for
        in-game outcomes, lost Primogems or resources, or any decisions you make based on this
        guide. Character builds involve trade-offs; what works for one roster may not work for
        another.
      </p>

      <h2 class="mt-10 text-2xl">Changes</h2>
      <p>
        If these terms ever change, the update date below will be revised. Last updated: September
        21, 2026.
      </p>
    </div>
  </main>
</Layout>
